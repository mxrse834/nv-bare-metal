static void
gp100_runl_insert_chan(struct nvkm_chan *chan, struct nvkm_memory *memory, u64 offset)
{
	nvkm_wo32(memory, offset + 0, chan->id | chan->runq << 14);
	nvkm_wo32(memory, offset + 4, chan->inst->addr >> 12);
}

